idth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"x":801.3571428571427,"y":599.2142857142858,"strokeColor":"#c92a2a","backgroundColor":"transparent","width":65,"height":24,"seed":1639355118,"groupIds":[],"strokeSharpness":"sharp","boundElements":[],"updated":1789463675003,"link":null,"fontSize":16,"fontFamily":2,"text":"功能使用","baseline":19,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"功能使用"},{"id":"qTm1JdZliqAcA_7vgN8ad","type":"rectangle","x":1611.2174479166667,"y":836.72265625,"width":271,"height":1188,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"strokeSharpness":"round","seed":2146201510,"version":123,"versionNonce":1283370618,"isDeleted":false,"boundElements":[{"type":"text","id":"gSGicDWOgi5d14ekl4C9B"}],"updated":1789544998215,"link":null},{"id":"gSGicDWOgi5d14ekl4C9B","type":"text","x":1616.2174479166667,"y":1027.0546875,"width":261,"height":1178,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"strokeSharpness":"round","seed":1050618170,"version":5,"versionNonce":1510045114,"isDeleted":false,"boundElements":null,"updated":1789544989146,"link":null,"text":"| 字段名 | 用途 |\n|---|---|\n| `ver` | 凭证协议版本，初始值为 `1` \n|\n| `iss` | 签发方标识，例如 \n`tbs-business-backend`；AI \n后端只信任配置的签发方 |\n| `aud` | \n凭证目标服务；根据调用目标填写 \n`hazard-ai-backend` 或 \n`emergency-ai-backend`，不直接填\n写 AI 网关 |\n| `sub` | 当前操作用户 \nID，对应业务系统用户唯一标识 |\n| `sid` | \n当前登录会话标识或不可逆会话摘要\n，用于审计和风险控制；不得传递原\n始 Token |\n| `platform_code` | \n业务平台编码，用于区分铁布衫、天\n眼等平台 |\n| `client_type` | \n客户端类型，建议固定枚举：`web`\n、`wechat_miniapp`、`app` |\n| `tenant_id` | \n当前用户所在企业或机构 \nID；个人上下文可不传 |\n| `scene` | 业务场景编码，例如 \n`hidden_inspection`、`emergency_a\nssistance` |\n| `operation` | \n本次请求的稳定授权和计费动作编码\n，例如 \n`hidden.ai_analyze`；必须与实际接\n口能力匹配 |\n| `resource_id` | 本次操作的业务对象\nID，例如隐患、任务 \nID；无具体业务对象时可不传 |\n| `billing_account_type` | \n实际扣费账户类型，建议固定枚举：\n`user`、`tenant` |\n| `billing_account_id` | 实际扣费账户 \nID，必须由业务后端根据用户及组织\n关系确定 |\n| `product_code` | 使用的 AI \n产品或能力包编码，例如 \n`hidden-ai`、`emergency-ai` |\n| `request_id` | \n一次业务请求的全链路唯一标识，用\n于日志、审计和用量聚合 |\n| `idempotency_key` | \n业务操作幂等标识，用于防止客户端\n重试造成重复执行或重复扣费 |\n| `iat` | 凭证签发时间，使用 Unix \n时间戳 |\n| `nbf` | 凭证开始生效时间，使用 \nUnix 时间戳 |\n| `exp` | 凭证失效时间，建议签发后 \n`30～120` 秒 |\n| `jti` | \n单次凭证的唯一编号，用于凭证审计\n和异常重放检测 |","fontSize":16,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":1174,"containerId":"qTm1JdZliqAcA_7vgN8ad","originalText":"| 字段名 | 用途 |\n|---|---|\n| `ver` | 凭证协议版本，初始值为 `1` |\n| `iss` | 签发方标识，例如 `tbs-business-backend`；AI 后端只信任配置的签发方 |\n| `aud` | 凭证目标服务；根据调用目标填写 `hazard-ai-backend` 或 `emergency-ai-backend`，不直接填写 AI 网关 |\n| `sub` | 当前操作用户 ID，对应业务系统用户唯一标识 |\n| `sid` | 当前登录会话标识或不可逆会话摘要，用于审计和风险控制；不得传递原始 Token |\n| `platform_code` | 业务平台编码，用于区分铁布衫、天眼等平台 |\n| `client_type` | 客户端类型，建议固定枚举：`web`、`wechat_miniapp`、`app` |\n| `tenant_id` | 当前用户所在企业或机构 ID；个人上下文可不传 |\n| `scene` | 业务场景编码，例如 `hidden_inspection`、`emergency_assistance` |\n| `operation` | 本次请求的稳定授权和计费动作编码，例如 `hidden.ai_analyze`；必须与实际接口能力匹配 |\n| `resource_id` | 本次操作的业务对象 ID，例如隐患、任务 ID；无具体业务对象时可不传 |\n| `billing_account_type` | 实际扣费账户类型，建议固定枚举：`user`、`tenant` |\n| `billing_account_id` | 实际扣费账户 ID，必须由业务后端根据用户及组织关系确定 |\n| `product_code` | 使用的 AI 产品或能力包编码，例如 `hidden-ai`、`emergency-ai` |\n| `request_id` | 一次业务请求的全链路唯一标识，用于日志、审计和用量聚合 |\n| `idempotency_key` | 业务操作幂等标识，用于防止客户端重试造成重复执行或重复扣费 |\n| `iat` | 凭证签发时间，使用 Unix 时间戳 |\n| `nbf` | 凭证开始生效时间，使用 Unix 时间戳 |\n| `exp` | 凭证失效时间，建议签发后 `30～120` 秒 |\n| `jti` | 单次凭证的唯一编号，用于凭证审计和异常重放检测 |"}],"appState":{"theme":"light","currentChartType":"bar","currentItemBackgroundColor":"#ffffff","currentItemEndArrowhead":"arrow","currentItemFillStyle":"solid","currentItemFontFamily":2,"currentItemFontSize":16,"currentItemLinearStrokeSharpness":"round","currentItemOpacity":100,"currentItemRoughness":0,"currentItemStartArrowhead":null,"currentItemStrokeColor":"#c92a2a","currentItemStrokeSharpness":"round","currentItemStrokeStyle":"solid","currentItemStrokeWidth":1,"currentItemTextAlign":"left","cursorButton":"up","editingGroupId":null,"elementLocked":false,"elementType":"selection","exportBackground":true,"exportScale":3,"exportEmbedScene":false,"exportWithDarkMode":false,"gridSize":null,"lastPointerDownWith":"mouse","name":"Untitled-2026-09-15-1452","openMenu":null,"previousSelectedElementIds":{"qTm1JdZliqAcA_7vgN8ad":true,"V96H7UwCs1nOSNrQJ3poT":true},"scrolledOutside":false,"scrollX":-212.5,"scrollY":-115.375,"selectedElementIds":{},"selectedGroupIds":{},"shouldCacheIgnoreZoom":false,"showStats":false,"viewBackgroundColor":"#ffffff","zenModeEnabled":false,"zoom":{"value":0.6}},"files":{}}